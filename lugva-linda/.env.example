# Runtime database URL used by Prisma Client
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Direct connection used by Prisma and optional migration connection
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres
MIGRATE_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase public client keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Web Push VAPID — générer avec : node scripts/generate-vapid-keys.js
# La clé publique est exposée au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<base64url-public-key>
# La clé privée ne doit JAMAIS être commitée ni exposée côté client
VAPID_PRIVATE_KEY=<base64url-private-key>
# Identifiant de l'expéditeur (email ou URL)
VAPID_SUBJECT=mailto:contact@example.com

# Secret partagé pour authentifier les appels Vercel Cron Jobs
# Générer avec : openssl rand -base64 32
CRON_SECRET=<random-secret>
