generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Core enums
// -----------------------------------------------------------------------------
enum Role {
  ADMIN
  USER
  CONTRIBUTOR
}

enum ExerciseCategory {
  READING
  WRITING
  PRONUNCIATION
}

enum ExerciseType {
  RECOGNITION
  REVERSE
  SPELLING
  SPEAKING
}

enum ReviewGrade {
  AGAIN
  HARD
  GOOD
  EASY
}

enum WordStatus {
  ACTIVE
  TO_COMPLETE
}

// -----------------------------------------------------------------------------
// Identity and access
// -----------------------------------------------------------------------------
model User {
  id        String   @id
  email     String   @unique
  username  String?  @db.VarChar(32)
  role      Role     @default(USER)
  colorHex  String   @default("#1B1B1B") @db.VarChar(7)
  activeLanguageId String?
  targetOwnerId    String?
  lastContributorVisitAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeLanguage   Language?   @relation("UserActiveLanguage", fields: [activeLanguageId], references: [id], onDelete: SetNull)
  learningLanguages UserLanguage[]
  ownedWords        Word[]      @relation("WordOwner")
  createdWords      Word[]      @relation("WordCreator")
  cards             Card[]      @relation("CardOwner")
  reviewLogs        ReviewLog[] @relation("ReviewLogOwner")
  createdLanguages  Language[]
  targetOwner  User?  @relation("ContributorTarget", fields: [targetOwnerId], references: [id], onDelete: SetNull)
  contributors User[] @relation("ContributorTarget")
  dailyStats   DailyStat[] @relation("DailyStatOwner")

  // Notifications push
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
}

// -----------------------------------------------------------------------------
// Languages (global) + user enrollment/progression scope
// -----------------------------------------------------------------------------
model Language {
  id        String   @id @default(uuid())
  code      String?  @unique @db.VarChar(12)
  name      String   @db.VarChar(64)
  nameNorm  String   @unique @db.VarChar(64)
  createdBy String
  createdAt DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  activeUsers   User[]       @relation("UserActiveLanguage")
  learningUsers UserLanguage[]
  words         Word[]
  cards         Card[]
  reviewLogs    ReviewLog[]
  dailyStats    DailyStat[]

  @@index([createdBy])
}

model UserLanguage {
  id         String   @id @default(uuid())
  userId     String
  languageId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId])
  @@index([userId])
  @@index([languageId])
}

// -----------------------------------------------------------------------------
// Encyclopedia words (owned by user, globally searchable, copy-on-duplicate)
// -----------------------------------------------------------------------------
model Word {
  id          String @id @default(uuid())
  ownerId     String
  languageId  String
  createdById String

  term                  String
  termNormalized        String
  translation           String
  translationNormalized String
  mandatoryTag          String
  status                WordStatus @default(ACTIVE)
  tags                  String[] @default([])
  synonyms              String[] @default([])
  relatedWords          String[] @default([])
  notesBlocks           Json?

  customAudioPath String?
  customAudioUrl  String?

  sourceWordId String?
  isDeleted  Boolean  @default(false)
  deletedAt  DateTime?
  purgeAfter DateTime?
  deleteToken BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User     @relation("WordOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creator    User     @relation("WordCreator", fields: [createdById], references: [id], onDelete: Restrict)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  sourceWord Word?    @relation("WordSource", fields: [sourceWordId], references: [id], onDelete: SetNull)
  copies     Word[]   @relation("WordSource")

  cards Card[]

  @@unique([id, ownerId, languageId])
  @@unique([ownerId, languageId, term, mandatoryTag, deleteToken])
  @@index([ownerId, languageId, isDeleted, createdAt])
  @@index([ownerId, languageId, isDeleted, termNormalized])
  @@index([ownerId, languageId, isDeleted, termNormalized, mandatoryTag])
  @@index([languageId, isDeleted, termNormalized])
  @@index([languageId, isDeleted, translationNormalized])
  @@index([sourceWordId])
  @@index([isDeleted, purgeAfter])
  @@index([ownerId, languageId, status, isDeleted])
}

// -----------------------------------------------------------------------------
// FSRS cards and review history
// -----------------------------------------------------------------------------
model Card {
  id         String @id @default(uuid())
  wordId     String
  ownerId    String
  languageId String

  category ExerciseCategory
  type     ExerciseType

  due           DateTime @default(now())
  stability     Float    @default(0)
  difficulty    Float    @default(0)
  scheduledDays Int      @default(0)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  state         Int      @default(0)
  lastReview    DateTime?
  isWordDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  word     Word     @relation(fields: [wordId, ownerId, languageId], references: [id, ownerId, languageId], onDelete: Cascade)
  owner    User     @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  reviewLogs ReviewLog[]

  @@unique([wordId, type])
  @@index([ownerId, languageId, due, state, isWordDeleted])
  @@index([ownerId, due, state])
  @@index([languageId, due])
}

model ReviewLog {
  id         String @id @default(uuid())
  cardId     String
  ownerId    String
  languageId String

  grade      ReviewGrade
  reviewDate DateTime @default(now())
  durationMs Int?

  // Snapshot before card update.
  state           Int
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  lastElapsedDays Int
  scheduledDays   Int

  card     Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  owner    User     @relation("ReviewLogOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@index([cardId, reviewDate])
  @@index([ownerId, reviewDate])
  @@index([ownerId, languageId, reviewDate])
}

// -----------------------------------------------------------------------------
// Daily Activity Stats (Journal d'activité, Statistiques & Calendrier)
// -----------------------------------------------------------------------------
model DailyStat {
  id         String   @id @default(uuid())
  ownerId    String
  languageId String
  date       String   @db.VarChar(10) // Format "YYYY-MM-DD"

  hadDueCards Boolean @default(false)
  completedCards Int  @default(0)

  // Ventilation par type d'exercice
  readingCompleted       Int @default(0)
  writingCompleted       Int @default(0)
  pronunciationCompleted Int @default(0)

  // Suivi du Temps (En millisecondes)
  totalDurationMs        Int @default(0)

  // Distribution des notes (Pour la page Statistiques)
  againCount             Int @default(0)
  hardCount              Int @default(0)
  goodCount              Int @default(0)
  easyCount              Int @default(0)

  owner    User     @relation("DailyStatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([ownerId, languageId, date])
  @@index([ownerId, languageId, date])
}

// -----------------------------------------------------------------------------
// Web Push Notifications
// -----------------------------------------------------------------------------

/// Souscription push d'un appareil (une entrée par appareil/navigateur par utilisateur).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Préférences de notifications d'un utilisateur (une ligne par utilisateur).
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique

  // Apprenants (role = USER)
  sessionReminderEnabled   Boolean  @default(true)
  /// IDs des langues pour lesquelles le rappel est activé.
  /// Tableau vide = toutes les langues actives de l'utilisateur sont incluses.
  sessionReminderLanguages String[] @default([])
  wordCompletedEnabled     Boolean  @default(true)

  // Contributeurs (role = CONTRIBUTOR)
  wordAssignedEnabled      Boolean  @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}